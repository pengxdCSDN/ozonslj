APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
# 云端正式运行必须使用 PostgreSQL；示例不包含真实主机、账号或密码。
DATABASE_URL=postgresql://ozonslj:replace-me@postgres:5432/ozonslj
# Redis 只承载可恢复队列、锁、限流和短期协调状态。
REDIS_URL=redis://redis:6379/0
# 当前部署绑定的内部运营组织；不在登录页或其他客户端界面开放选择。
DEFAULT_ORGANIZATION_ID=org-default
OZON_MODE=stub
OZON_BASE_URL=https://api-seller.ozon.ru
# 本地使用受限 Secret 文件；云端 Compose 挂载 /run/secrets/ozon_credential_key。
OZON_CREDENTIAL_KEY_FILE=secrets/ozon_credential_key
OZON_CREDENTIAL_KEY_VERSION=1
SYNC_DISPATCH_INTERVAL_SECONDS=5
SYNC_DISPATCH_BATCH_SIZE=100
SYNC_WORKER_BLOCK_MS=1000
SYNC_WORKER_LEASE_SECONDS=30
SYNC_WORKER_RETRY_DELAY_SECONDS=60
LOG_LEVEL=DEBUG
# 扩展构建时注入的后端地址；本地可留空并使用 127.0.0.1:8000，云端填写 HTTPS API 地址。
VITE_API_BASE_URL=
